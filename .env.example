# NextAuth — local: match `npm run dev` (3002). Vercel: https://supreme-client-front.vercel.app (no trailing slash)
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Supreme System API (server-side only; do not expose as NEXT_PUBLIC_*)
# Local: http://localhost:3000. Vercel: https://supreme-system-back.onrender.com (no /api/v1, no trailing slash)
API_URL=http://localhost:3000
